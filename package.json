{
  "name": "deshaatan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "overrides": {
    "undici": "^7.29.1",
    "nodemailer": "^10.0.9",
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.12"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --quiet",
    "db:local": "node scripts/setup-local-postgres.mjs",
    "cms:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-cms.ts",
    "cms:migrate-media": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-media-to-database.ts",
    "cms:types": "node --env-file-if-exists=.env.local node_modules/payload/bin.js generate:types",
    "cms:importmap": "node --env-file-if-exists=.env.local node_modules/payload/bin.js generate:importmap",
    "cms:migrate": "node scripts/migrate-cms.mjs",
    "cms:check-neon": "node scripts/check-neon.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-cloud-storage": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.10.1",
    "graphql": "16.14.2",
    "next": "16.3.8",
    "nodemailer": "^10.0.9",
    "payload": "3.90.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
